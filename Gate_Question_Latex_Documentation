\subsection{Working Principle}

The Arduino firmware automatically generates all eight possible binary
combinations of inputs $A$, $B$, and $C$ in a continuous loop. The LEDs
connected to pins \texttt{D2}, \texttt{D3}, and \texttt{D4} provide a visual
indication of the current input state. The LED connected to pin \texttt{D5}
represents the output $Y$. Since the simplified Boolean expression evaluates to
$Y = 1$ unconditionally, the output LED remains \textbf{continuously illuminated}
for every input combination, providing clear empirical confirmation of the
simplification.

%% ─── Arduino Program ─────────────────────────────────────────────────────────
\section{Arduino Program}

\begin{arduinobox}
const int A_LED = 2;   // Input A indicator
const int B_LED = 3;   // Input B indicator
const int C_LED = 4;   // Input C indicator
const int Y_LED = 5;   // Output Y (always HIGH)

void setup()
{
    pinMode(A_LED, OUTPUT);
    pinMode(B_LED, OUTPUT);
    pinMode(C_LED, OUTPUT);
    pinMode(Y_LED, OUTPUT);
}

void loop()
{
    for (int i = 0; i < 8; i++)
    {
        int A = (i >> 2) & 1;  // Extract bit 2
        int B = (i >> 1) & 1;  // Extract bit 1
        int C =  i       & 1;  // Extract bit 0

        digitalWrite(A_LED, A);
        digitalWrite(B_LED, B);
        digitalWrite(C_LED, C);

        // Y = 1 always; output LED remains ON
        digitalWrite(Y_LED, HIGH);

        delay(1000);  // Hold each combination for 1 second
    }
}
\end{arduinobox}

%% ─── Assembly Program ────────────────────────────────────────────────────────
\section{Assembly Program}

\begin{assemblybox}
.include "m328pdef.inc"    ; ATmega328P register definitions

.org 0x0000
rjmp MAIN                  ; Reset vector -> jump to MAIN

MAIN:
    ldi r16, 0b00111100    ; Configure DDRD: pins 2-5 as outputs
    out DDRD, r16

LOOP:
    ldi r17, 0             ; Initialise loop counter to 0

NEXT:
    mov r18, r17
    lsl r18                ; Shift left twice to align with PORTD pins 2-4
    lsl r18
    out PORTD, r18         ; Drive A, B, C LEDs

    sbi PORTD, 5           ; Set pin D5 HIGH (Y = 1 always)

    rcall DELAY            ; Approximately 1-second delay

    inc r17
    cpi r17, 8
    brne NEXT              ; Repeat for all 8 input combinations

    rjmp LOOP              ; Restart cycle indefinitely


DELAY:
    ldi r20, 100
L1: ldi r21, 255
L2: ldi r22, 255
L3: dec r22
    brne L3
    dec r21
    brne L2
    dec r20
    brne L1
    ret
\end{assemblybox}

